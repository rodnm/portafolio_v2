---
import Cap from "../components/hud/Cap.astro";
import Globe from "../components/hud/Globe.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="404 · Señal perdida · Lost signal"
  description="Página no encontrada · Page not found"
  noindex
  translated={false}
>
  <section class="mx-auto grid max-w-page gap-10 px-4 py-20 sm:px-10 md:grid-cols-[1fr_20rem] md:items-center">
    <div class="flex flex-col gap-5">
      <Cap dim>ERR. 404 — {"Señal perdida"} · Lost signal</Cap>
      <h1 class="text-hero font-semibold">
        <span class="block">Fuera de</span>
        <span class="block pl-8 font-light text-accent italic">órbita.</span>
      </h1>
      <p class="max-w-measure text-lead text-ink-dim">
        Esta página no existe o cambió de lugar.{" "}
        <span lang="en">This page doesn't exist or has moved.</span>
      </p>
      <div class="flex flex-wrap gap-3 font-mono text-cap uppercase">
        <a href={base} class="bg-ink px-4 py-3 text-canvas hover:bg-accent">
          ← Volver al inicio
        </a>
        <a href={`${base}en/`} lang="en" class="border border-ink px-4 py-3 hover:text-accent">
          ← Back home
        </a>
      </div>
    </div>
    <Globe class="w-64 text-ink-dim" title="Globo sin señal" />
  </section>
</BaseLayout>
