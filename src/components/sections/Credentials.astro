---
import { getImage, Image } from "astro:assets";
import { getCollection } from "astro:content";
import CredentialStrip from "../credentials/CredentialStrip.astro";
import CredentialWall from "../credentials/CredentialWall.svelte";
import Brackets from "../hud/Brackets.astro";
import Cap from "../hud/Cap.astro";
import SectionHead from "../hud/SectionHead.astro";
import { credentialCategories } from "../../content.config";
import type { Locale } from "../../i18n/locales";
import type { UI } from "../../i18n/ui";
import { formatMonth, formatPeriod } from "../../lib/format";
import bachelorThumb from "../../assets/generated/credentials/pucp-bachelor.webp";

interface Props {
  lang: Locale;
  t: UI;
}

const { lang, t } = Astro.props;
const all = (await getCollection("credentials")).sort((a, b) =>
  b.data.date.localeCompare(a.data.date),
);
const education = (await getCollection("education")).sort(
  (a, b) => Number(a.data.current) - Number(b.data.current),
);
const highlights = all.filter((c) => c.data.highlight);
const totalHours = all.reduce((sum, c) => sum + (c.data.hours ?? 0), 0);
const firstYear = Math.min(...all.map((c) => Number(c.data.date.slice(0, 4))));
const nf = new Intl.NumberFormat(lang === "es" ? "es-PE" : "en-US");

const cards = await Promise.all(
  all.map(async (c) => ({
    id: c.id,
    title: c.data.title[lang],
    issuer: c.data.issuer,
    date: formatMonth(c.data.date, lang),
    category: c.data.category,
    hours: c.data.hours,
    grade: c.data.grade,
    verify: c.data.verify,
    thumb: (await getImage({ src: c.data.thumb, width: 320, format: "webp" })).src,
  })),
);
const categoryOptions = credentialCategories.map((id) => ({
  id,
  label: t.credentials.categories[id],
}));
---

<section id="credentials" aria-labelledby="credentials-title" class="border-b border-hair">
  <div class="mx-auto max-w-page px-4 py-20 sm:px-10">
    <SectionHead
      id="credentials-title"
      chapter={t.credentials.chapter}
      title={t.credentials.title}
      kicker={t.credentials.kicker}
    />

    <h3 class="mb-4 text-display font-medium">{t.credentials.education}</h3>
    <ol class="mb-16 border-b border-hair">
      {education.map((e) => (
        <li class="grid gap-x-8 gap-y-3 border-t border-hair py-6 md:grid-cols-[9rem_1fr_10rem]">
          <span class="text-figure font-semibold text-accent tabular-nums">
            {e.data.current
              ? (e.data.start ?? "").slice(0, 4)
              : (e.data.conferred ?? e.data.end ?? "").slice(0, 4)}
          </span>
          <div class="flex flex-col gap-2">
            <h4 class="text-2xl font-medium tracking-tight">{e.data.title[lang]}</h4>
            <Cap>{e.data.org}</Cap>
            {e.data.note && <p class="text-ink-dim">{e.data.note[lang]}</p>}
            {e.data.current && (
              <Cap class="inline-flex items-center gap-2 text-signal">
                <span
                  class="size-2 rounded-full bg-signal motion-safe:animate-blip"
                  aria-hidden="true"
                />
                {t.credentials.current}
              </Cap>
            )}
          </div>
          {e.data.kind === "degree" && (
            <div class="relative self-start bg-paper p-2 max-md:max-w-40">
              <Image
                src={bachelorThumb}
                alt={`${t.credentials.thumbAlt}: ${e.data.title[lang]}`}
                width={160}
                class="w-full"
              />
              <Brackets />
            </div>
          )}
        </li>
      ))}
    </ol>

    <dl class="mb-12 grid grid-cols-3 gap-4 border-y border-rule py-5">
      <div class="flex flex-col gap-1">
        <dd class="order-1 text-figure font-semibold tabular-nums">{all.length}</dd>
        <Cap dim as="dt" class="order-2">
          {t.credentials.count}
        </Cap>
      </div>
      <div class="flex flex-col gap-1">
        <dd class="order-1 text-figure font-semibold tabular-nums">
          {nf.format(Math.round(totalHours))}
        </dd>
        <Cap dim as="dt" class="order-2">
          {t.credentials.hours}
        </Cap>
      </div>
      <div class="flex flex-col gap-1">
        <dd class="order-1 text-figure font-semibold tabular-nums">{firstYear}</dd>
        <Cap dim as="dt" class="order-2">
          {t.credentials.since}
        </Cap>
      </div>
    </dl>

    <h3 class="mb-4 text-display font-medium">{t.credentials.highlights}</h3>
    <ul class="mb-16 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {highlights.map((c) => (
        <li class="flex flex-col border border-hair">
          <div class="relative bg-paper p-3">
            <Image
              src={c.data.thumb}
              alt={`${t.credentials.thumbAlt}: ${c.data.title[lang]}`}
              widths={[320, 640]}
              sizes="(min-width: 1280px) 24rem, (min-width: 768px) 45vw, 100vw"
              class="aspect-video w-full object-contain"
            />
            <Brackets />
          </div>
          <div class="flex flex-1 flex-col gap-2 p-4">
            <Cap dim>
              {t.credentials.categories[c.data.category]} ·{" "}
              {c.data.start
                ? formatPeriod(c.data.start, c.data.date, lang)
                : formatMonth(c.data.date, lang)}
            </Cap>
            <h4 class="text-xl leading-snug font-medium">{c.data.title[lang]}</h4>
            <p class="text-sm text-ink-dim">{c.data.issuer}</p>
            {c.data.items && (
              <ul class="list-dash flex flex-col gap-1 text-sm">
                {c.data.items.map((item) => (
                  <li>{item[lang]}</li>
                ))}
              </ul>
            )}
            {c.data.note && <p class="text-sm text-ink-dim">{c.data.note[lang]}</p>}
            <p class="mt-auto flex flex-wrap gap-2 pt-2">
              {c.data.hours && (
                <Cap class="border border-hair px-2 py-1 tabular-nums">
                  {c.data.hours} {t.credentials.hoursShort}
                </Cap>
              )}
              {c.data.grade && (
                <Cap class="border border-accent px-2 py-1 text-accent tabular-nums">
                  {t.credentials.grade} {c.data.grade}
                </Cap>
              )}
              {c.data.scholarship && (
                <Cap class="bg-ink px-2 py-1 text-canvas">{t.credentials.scholarship}</Cap>
              )}
            </p>
          </div>
        </li>
      ))}
    </ul>

    <h3 class="mb-4 text-display font-medium">{t.credentials.timeline}</h3>
    <figure class="mb-16 flex flex-col gap-3">
      <CredentialStrip items={all} order={credentialCategories} lang={lang} t={t} />
      <figcaption>
        <Cap dim>{t.credentials.timelineTitle}</Cap>
      </figcaption>
    </figure>

    <h3 class="mb-4 text-display font-medium">{t.credentials.wall}</h3>
    <CredentialWall
      client:visible
      cards={cards}
      categories={categoryOptions}
      labels={{
        filter: t.projects.filter,
        all: t.projects.all,
        count: t.credentials.count,
        verify: t.credentials.verify,
        hours: t.credentials.hoursShort,
        thumbAlt: t.credentials.thumbAlt,
      }}
    />
    <Cap dim as="p" class="mt-4">
      {t.credentials.privacy}
    </Cap>
  </div>
</section>
