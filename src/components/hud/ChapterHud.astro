---
// Fixed readout of the chapter in view (desktop only). Filled in by the script below.
---

<p
  data-chapter-hud
  aria-hidden="true"
  class="pointer-events-none fixed bottom-4 left-4 z-30 hidden border border-rule bg-paper/95 px-3 py-2 font-mono text-cap uppercase tabular-nums shadow-sm lg:block"
>
  <span data-chapter-number>CAP. 01 / 10</span>
  <span class="text-ink-dim"> · </span>
  <span data-chapter-title class="text-ink-dim"></span>
</p>

<script is:inline>
  (() => {
    const hud = document.querySelector("[data-chapter-hud]");
    const sections = [...document.querySelectorAll("main section[id]")];
    if (!hud || !sections.length || !("IntersectionObserver" in window)) return;
    const prefix = document.documentElement.lang === "en" ? "CH." : "CAP.";
    const total = String(sections.length).padStart(2, "0");
    const show = (section) => {
      const i = sections.indexOf(section) + 1;
      const title =
        section.dataset.hudTitle || section.querySelector("h2")?.textContent?.trim() || "";
      hud.querySelector("[data-chapter-number]").textContent =
        `${prefix} ${String(i).padStart(2, "0")} / ${total}`;
      hud.querySelector("[data-chapter-title]").textContent = title;
    };
    show(sections[0]);
    const observer = new IntersectionObserver(
      (entries) => entries.filter((e) => e.isIntersecting).forEach((e) => show(e.target)),
      { rootMargin: "-45% 0px -50% 0px" },
    );
    sections.forEach((s) => observer.observe(s));
  })();
</script>
