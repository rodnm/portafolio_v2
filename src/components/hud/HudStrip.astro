---
import { site } from "../../data/site";
import type { UI } from "../../i18n/ui";
import Cap from "./Cap.astro";

interface Props {
  t: UI;
}

const { t } = Astro.props;
const year = new Date().getFullYear();
---

<div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-y border-rule bg-paper px-4 py-3 sm:px-10">
  <Cap class="inline-flex items-center gap-2">
    <span class="size-2 rounded-full bg-signal motion-safe:animate-blink" aria-hidden="true"></span>
    {t.hud.signal}
  </Cap>
  <Cap dim class="tabular-nums">
    {site.coordinates.label}
  </Cap>
  <Cap dim class="tabular-nums">
    {t.hud.local}{" "}
    <time data-clock class="text-ink">
      UTC−5
    </time>
  </Cap>
  <span class="font-mono text-cap text-ink-dim tabular-nums max-sm:hidden">
    t = {site.since} → {year}
  </span>
  <Cap dim class="max-sm:hidden">
    {t.hud.status}: <span class="text-signal">{t.hud.available}</span>
  </Cap>
</div>

<script is:inline define:vars={{ timeZone: site.timeZone }}>
  (() => {
    const clocks = document.querySelectorAll("[data-clock]");
    if (!clocks.length) return;
    const fmt = new Intl.DateTimeFormat("es-PE", {
      timeZone,
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
    });
    const tick = () => clocks.forEach((el) => (el.textContent = fmt.format(new Date())));
    tick();
    setInterval(tick, 30_000);
  })();
</script>
