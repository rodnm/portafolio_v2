---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../../i18n/locales";
import type { UI } from "../../i18n/ui";

// Strip plot built at build time: one row per area, one dot per credential.
interface Props {
  items: CollectionEntry<"credentials">[];
  order: readonly CollectionEntry<"credentials">["data"]["category"][];
  lang: Locale;
  t: UI;
}

const { items, order, t } = Astro.props;
const rows = order.filter((c) => items.some((i) => i.data.category === c));
const firstYear = Math.min(...items.map((i) => Number(i.data.date.slice(0, 4))));
const lastYear = new Date().getFullYear() + 1;
const W = 960;
const left = 200;
const right = 16;
const rowH = 34;
const top = 12;
const H = top + rows.length * rowH + 28;
const x = (ym: string) => {
  const [y, m] = ym.split("-").map(Number);
  return (
    left + (((y! - firstYear) * 12 + (m! - 1)) / ((lastYear - firstYear) * 12)) * (W - left - right)
  );
};
const years = Array.from({ length: lastYear - firstYear + 1 }, (_, i) => firstYear + i);
const r = (hours?: number) => Math.max(3.5, Math.sqrt(hours ?? 4) * 1.15);
const f = (n: number) => n.toFixed(1);
---

<div class="overflow-x-auto" tabindex="0" role="region" aria-label={t.credentials.timeline}>
  <svg class="min-w-160 w-full" viewBox={`0 0 ${W} ${H}`} role="img">
    <title>{t.credentials.timelineTitle}</title>
    <g class="text-hair" stroke="currentColor" stroke-width="1">
      {years.map((yr) => (
        <line x1={f(x(`${yr}-01`))} x2={f(x(`${yr}-01`))} y1={top} y2={H - 24} />
      ))}
    </g>
    <g class="fill-ink-dim font-mono" font-size="11">
      {years.map((yr) => (
        <text x={f(x(`${yr}-01`))} y={H - 8} text-anchor="middle">
          {yr}
        </text>
      ))}
    </g>
    {rows.map((category, i) => {
      const cy = top + i * rowH + rowH / 2;
      return (
        <g>
          <line
            class="text-hair"
            stroke="currentColor"
            stroke-dasharray="2 4"
            x1={left}
            x2={W - right}
            y1={cy}
            y2={cy}
          />
          <text
            x={left - 12}
            y={cy + 4}
            text-anchor="end"
            class="fill-ink font-display"
            font-size="13"
          >
            {t.credentials.categories[category]}
          </text>
          {items
            .filter((it) => it.data.category === category)
            .map((it, j) => (
              <circle
                class:list={["reveal-pop", it.data.highlight ? "fill-accent" : "fill-ink/70"]}
                style={`--i: ${j}`}
                cx={f(x(it.data.date))}
                cy={cy}
                r={f(r(it.data.hours))}
                stroke="var(--color-canvas)"
                stroke-width="1.5"
              />
            ))}
        </g>
      );
    })}
  </svg>
</div>
