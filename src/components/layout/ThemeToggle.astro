---
import type { UI } from "../../i18n/ui";

interface Props {
  t: UI;
}

const { t } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  class="inline-flex size-11 items-center justify-center text-ink transition-colors hover:text-accent"
  aria-label={t.theme.toggle}
  title={t.theme.toggle}
>
  <svg
    class="size-5 dark:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4.5"></circle>
    <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"></path>
  </svg>
  <svg
    class="hidden size-5 dark:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
  >
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
  </svg>
</button>

<script is:inline>
  document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem("rn-theme", next);
      } catch {}
    });
  });
</script>
