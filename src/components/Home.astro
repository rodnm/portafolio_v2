---
import About from "./sections/About.astro";
import Contact from "./sections/Contact.astro";
import Credentials from "./sections/Credentials.astro";
import Events from "./sections/Events.astro";
import Papers from "./sections/Papers.astro";
import Studies from "./sections/Studies.astro";
import Experience from "./sections/Experience.astro";
import Opening from "./sections/Opening.astro";
import Projects from "./sections/Projects.astro";
import Stack from "./sections/Stack.astro";
import { getCollection } from "astro:content";
import StataConsole from "./console/StataConsole.svelte";
import ChapterHud from "./hud/ChapterHud.astro";
import { site } from "../data/site";
import type { Locale } from "../i18n/locales";
import { localePath } from "../i18n/routes";
import { ui } from "../i18n/ui";
import { getProjects, projectSlug } from "../lib/projects";
import { ols, simulate } from "../lib/regression";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];
const skills = (await getCollection("skills")).sort((a, b) => a.data.order - b.data.order);
const projects = await getProjects(lang);
const fit = ols(simulate({ n: 28, seed: 2019 }));
---

<Opening lang={lang} t={t} />
<About lang={lang} t={t} />
<Experience lang={lang} t={t} />
<Projects lang={lang} t={t} />
<Credentials lang={lang} t={t} />
<Studies lang={lang} t={t} />
<Papers lang={lang} t={t} />
<Events lang={lang} t={t} />
<Stack lang={lang} t={t} />
<Contact t={t} />
<ChapterHud />
<StataConsole
  client:media="(min-width: 1024px)"
  labels={t.console}
  stack={skills.map((g) => ({ label: g.data.label[lang], count: g.data.items.length }))}
  projects={projects.map((p) => ({
    title: p.data.title,
    href: localePath(lang, `projects/${projectSlug(p)}`),
  }))}
  email={site.email}
  fit={{
    intercept: fit.intercept,
    slope: fit.slope,
    interceptSE: fit.interceptSE,
    slopeSE: fit.slopeSE,
    r2: fit.r2,
    n: fit.n,
  }}
  langHrefs={{ es: localePath("es"), en: localePath("en") }}
/>
