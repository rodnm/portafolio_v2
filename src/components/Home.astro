---
import About from "./sections/About.astro";
import Contact from "./sections/Contact.astro";
import Credentials from "./sections/Credentials.astro";
import Events from "./sections/Events.astro";
import Papers from "./sections/Papers.astro";
import Studies from "./sections/Studies.astro";
import Experience from "./sections/Experience.astro";
import Opening from "./sections/Opening.astro";
import Projects from "./sections/Projects.astro";
import Stack from "./sections/Stack.astro";
import type { Locale } from "../i18n/locales";
import { ui } from "../i18n/ui";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<Opening lang={lang} t={t} />
<About lang={lang} t={t} />
<Experience lang={lang} t={t} />
<Projects lang={lang} t={t} />
<Credentials lang={lang} t={t} />
<Studies lang={lang} t={t} />
<Papers lang={lang} t={t} />
<Events lang={lang} t={t} />
<Stack lang={lang} t={t} />
<Contact t={t} />
