---
import type { UI } from "../../i18n/ui";
import { projectButton } from "./emphasis";

interface Props {
  links: { kind: keyof UI["projects"]["links"]; url: string }[];
  t: UI;
}

const { links, t } = Astro.props;
---

<ul class="flex flex-wrap gap-2">
  {links.map((link) => (
    <li>
      <a href={link.url} target="_blank" rel="noopener" class={projectButton}>
        {t.projects.links[link.kind]} <span aria-hidden="true">↗</span>
      </a>
    </li>
  ))}
</ul>
