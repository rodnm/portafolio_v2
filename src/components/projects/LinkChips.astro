---
import type { UI } from "../../i18n/ui";

interface Props {
  links: { kind: keyof UI["projects"]["links"]; url: string }[];
  t: UI;
}

const { links, t } = Astro.props;
---

<ul class="flex flex-wrap gap-2">
  {links.map((link) => (
    <li>
      <a
        href={link.url}
        target="_blank"
        rel="noopener"
        class="inline-flex min-h-9 items-center gap-1 border border-hair px-2.5 font-mono text-cap uppercase transition-colors hover:border-accent hover:text-accent"
      >
        {t.projects.links[link.kind]} <span aria-hidden="true">↗</span>
      </a>
    </li>
  ))}
</ul>
