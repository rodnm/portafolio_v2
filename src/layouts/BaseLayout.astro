---
import { Font } from "astro:assets";
import Footer from "../components/layout/Footer.astro";
import Masthead from "../components/layout/Masthead.astro";
import { toLocale } from "../i18n/locales";
import { localePath, switchLocalePath } from "../i18n/routes";
import { ui } from "../i18n/ui";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  type?: "website" | "article";
  /** False for pages that exist in one language only (404, internal pages). */
  translated?: boolean;
}

const lang = toLocale(Astro.currentLocale);
const t = ui[lang];
const {
  title = t.meta.title,
  description = t.meta.description,
  noindex = false,
  type = "website",
  translated = true,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const site = Astro.site ?? new URL("https://rodnm.github.io");
const canonical = new URL(Astro.url.pathname, site).href;
const otherLang = lang === "es" ? "en" : "es";
// Untranslated pages send the language switch to the other language's home page.
const switchHref = translated
  ? switchLocalePath(Astro.url.pathname, base, otherLang)
  : localePath(otherLang, "", base);
const esUrl = new URL(switchLocalePath(Astro.url.pathname, base, "es"), site).href;
const enUrl = new URL(switchLocalePath(Astro.url.pathname, base, "en"), site).href;
const ogImage = new URL(`${base}og/og-${lang}.png`, site).href;
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Rodrigo Andrés Norabuena Mascaraqui",
  alternateName: "Rodrigo Norabuena",
  jobTitle: lang === "es" ? "Economista | Analytics" : "Economist | Analytics",
  url: new URL(base, site).href,
  email: "rodrigoandres.norabuena@gmail.com",
  image: new URL(`${base}og/og-${lang}.png`, site).href,
  alumniOf: { "@type": "CollegeOrUniversity", name: "Pontificia Universidad Católica del Perú" },
  address: { "@type": "PostalAddress", addressLocality: "Lima", addressCountry: "PE" },
  knowsLanguage: ["es", "en"],
  sameAs: ["https://github.com/rodnm", "https://www.linkedin.com/in/rodnm"],
};
---

<!doctype html>
<html lang={lang} id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {translated && (
      <>
        <link rel="alternate" hreflang="es" href={esUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="x-default" href={esUrl} />
      </>
    )}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f0ebde" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14110d" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Rodrigo Norabuena" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === "es" ? "es_PE" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "es" ? "en_US" : "es_PE"} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <Font cssVariable="--font-space-grotesk" preload />
    <Font cssVariable="--font-ibm-plex-mono" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("js");
        let theme;
        try {
          theme = localStorage.getItem("rn-theme");
        } catch {}
        if (theme !== "light" && theme !== "dark") {
          theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        root.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="bg-canvas text-ink antialiased">
    <a
      href="#main"
      class="focus-reveal fixed top-3 left-3 z-50 bg-ink px-4 py-3 font-mono text-cap text-canvas uppercase"
    >
      {t.a11y.skip}
    </a>
    <Masthead lang={lang} t={t} switchHref={switchHref} />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer t={t} />
  </body>
</html>
